{
  "identifier": "default",
  "description": "Default capabilities for Nexivora desktop",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:image:default",
    "core:path:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:webview:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:scope-home",
    "fs:scope-desktop",
    "fs:scope-document",
    "fs:scope-download",
    "fs:scope-picture",
    "fs:scope-temp",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm"
  ]
}
