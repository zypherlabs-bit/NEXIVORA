{
  "productName": "Nexivora",
  "version": "0.1.0",
  "identifier": "com.nexivora.desktop",
  "build": {
    "beforeDevCommand": null,
    "beforeBuildCommand": null,
    "devUrl": "http://localhost:1420",
    "frontendDist": "./dist"
  },
  "plugins": {},
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexivora",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: https://asset.localhost; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline' asset: https://asset.localhost; script-src 'self' 'unsafe-inline' asset: https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Nexivora Office Suite",
    "longDescription": "Free, open-source, privacy-first desktop productivity suite with document, spreadsheet, presentation, and database engines.",
    "copyright": "Copyright (c) 2026 Nexivora Contributors",
    "resources": [],
    "externalBin": [],
    "windows": {
      "wix": {
        "language": ["en-US"],
        "template": null
      },
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "signCommand": null,
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "entitlements": null,
      "hardenedRuntime": false
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1", "librsvg2-2"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libayatana-appindicator", "librsvg2"]
      }
    }
  }
}
